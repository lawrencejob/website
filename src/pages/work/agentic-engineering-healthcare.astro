---
import Layout from "../../layouts/Layout.astro";
import PageIntro from "../../components/PageIntro.astro";
import SectionLabel from "../../components/SectionLabel.astro";

// Lifecycle flowchart data. Copper-bordered cards are human decision points;
// grey cards are agents.
const stages = [
	{
		label: "Intent",
		width: "w-[180px]",
		cards: [{ human: true, kicker: "Human", title: "Me", blurb: "Clinical need, scope, appetite for risk" }],
	},
	{
		label: "Specify",
		width: "w-[190px]",
		cards: [
			{ kicker: "Agent", title: "Spec writer", blurb: "Requirements with acceptance criteria" },
			{ kicker: "Agent", title: "Clinical risk", blurb: "Drafts hazard candidates per requirement" },
		],
	},
	{
		label: "Build",
		width: "w-[190px]",
		cards: [
			{ kicker: "Agents · parallel", title: "Implementers", blurb: "One per requirement, small diffs only" },
			{ kicker: "Agent", title: "Test writer", blurb: "Tests from the spec, not the code" },
		],
	},
	{
		label: "Verify",
		width: "w-[190px]",
		cards: [
			{ kicker: "Agent · adversarial", title: "Reviewer", blurb: "Argues against the diff; rejection is cheap" },
			{ kicker: "Agent", title: "Safety case", blurb: "Updates hazard log entries touched by the change" },
		],
	},
	{
		label: "Gate",
		width: "w-[190px]",
		cards: [
			{
				human: true,
				kicker: "Human · sign-off",
				title: "Clinical Safety Officer",
				blurb: "Reviews the delta, not the pile. Nothing ships without this.",
			},
		],
	},
	{
		label: "Release",
		width: "w-[150px]",
		cards: [{ title: "Ship", blurb: "With the safety case attached" }],
	},
];

const toc = [
	{ id: "why-healthcare-is-different", label: "Why healthcare is different" },
	{ id: "the-agent-team", label: "The agent team" },
	{ id: "the-living-hazard-log", label: "The living hazard log" },
	{ id: "quality-without-slowing", label: "Quality without slowing" },
];

const journal = [
	{
		date: "Sep 2025",
		title: "Teaching agents to speak clinical risk",
		blurb: "Severity, likelihood, and why an agent's confidence is not a risk score.",
	},
	{
		date: "Nov 2025",
		title: "DCB0129 and automating the hazard log",
		blurb: "Turning the standard's clauses into a schema agents can keep true on every commit.",
	},
	{
		date: "Jan 2026",
		title: "When the reviewer argues with the builder",
		blurb: "Adversarial agents as a quality mechanism, and how to stop them agreeing.",
	},
	{
		date: "Apr 2026",
		title: "Traceability from prompt to release",
		blurb: "Every shipped line answers: which requirement, which hazard, whose sign-off.",
	},
];

const lessons = [
	"Regulation is a traceability problem. Agents are very good at traceability.",
	"Draft hazards before code exists. Safety analysis belongs at the front.",
	"Human gates get faster when agents assemble the evidence and humans only judge.",
	"An adversarial reviewer is only useful if rejection is cheap. Make rejection cheap.",
	"Small diffs aren't a style preference in healthcare — they're what makes sign-off reviewable.",
	"A safety process you can afford to run continuously is a better safety process.",
];

// Same fluid page rhythm as the Departures page.
const pagePad = "px-[clamp(20px,5vw,56px)]";
const bleed = "px-[clamp(0px,calc((100vw-720px)*0.16),56px)]";
const cardPad = "px-[clamp(20px,3vw,40px)] py-[clamp(24px,3vw,36px)]";
const prose = "mb-5.5 text-[17px] leading-[1.75] text-pretty text-ink-soft";
const heading = "mb-4.5 font-display text-[26px] font-semibold tracking-[-0.02em] text-ink";
---

<Layout
	title="Agentic Engineering in Healthcare — Lawrence Job"
	crumbs={[{ label: "Work", href: "/work" }, { label: "Agentic Engineering in Healthcare" }]}
>
	<!-- Reading progress bar -->
	<div id="reading-progress" class="fixed top-0 left-0 z-50 h-0.5 w-0 bg-copper" aria-hidden="true"></div>

	<PageIntro
		class:list={["pt-[clamp(56px,8vw,110px)] pb-[clamp(40px,6vw,64px)]", pagePad]}
		eyebrow="Case study · Regulated delivery"
		title="Agentic engineering in healthcare"
		lede="Clinical software carries clinical risk, and clinical risk carries paperwork: hazard logs, safety cases, sign-off. This is the story of using a team of agents to deliver a lot of functionality inside that regime — without the regime becoming the bottleneck, and without quality becoming a casualty."
	/>

	<!-- The lifecycle flowchart — full-bleed band, horizontally scrollable -->
	<section class="mx-[calc(50%-50vw)] bg-card py-[clamp(36px,5vw,56px)]">
		<div class="mx-auto max-w-[1440px]">
			<div class:list={["flex items-baseline gap-4 pb-2", pagePad]}>
				<SectionLabel>The lifecycle</SectionLabel>
				<span class="text-[13px] text-ink-mute opacity-70">How the agents interacted, and where the humans sit</span>
			</div>

			<div class="no-scrollbar overflow-x-auto pt-5 pb-1">
				<div class:list={["mx-auto w-max min-w-[min(1240px,100%)]", pagePad]}>
					<div class="flex items-stretch">
						{
							stages.map((stage, i) => (
								<>
									{i > 0 && (
										<div class="flex w-11 flex-none items-center justify-center pt-5.5">
											<span class="text-lg text-copper" aria-hidden="true">
												→
											</span>
										</div>
									)}
									<div class:list={["flex flex-none flex-col gap-2", stage.width]}>
										<p class="px-0.5 pb-1.5 text-[11px] tracking-[0.14em] uppercase text-ink-mute">{stage.label}</p>
										{stage.cards.map((card) => (
											<div
												class:list={[
													"border px-4 pt-4 pb-3.5",
													card.human ? "border-copper/55 bg-[#1F1B17]" : "border-ink/12 bg-[#202020]",
													stage.cards.length === 1 && "flex-1",
													!card.kicker && "flex flex-col justify-center",
												]}
											>
												{card.kicker && (
													<p
														class:list={[
															"mb-2 text-[10.5px] tracking-[0.12em] uppercase",
															card.human ? "text-copper" : "text-ink-mute",
														]}
													>
														{card.kicker}
													</p>
												)}
												<p class="font-display text-base font-semibold tracking-[-0.01em] text-ink">{card.title}</p>
												<p class="mt-1.5 text-[12.5px] leading-[1.5] text-ink-mute">{card.blurb}</p>
											</div>
										))}
									</div>
								</>
							))
						}
					</div>

					<!-- Artefact lane: the hazard log runs underneath Specify → Verify -->
					<div class="mt-3.5 flex items-center">
						<div class="w-[224px] flex-none"></div>
						<div class="w-[848px] flex-none">
							<div class="flex h-4.5 justify-around" aria-hidden="true">
								<div class="border-l border-dashed border-copper/50"></div>
								<div class="border-l border-dashed border-copper/50"></div>
								<div class="border-l border-dashed border-copper/50"></div>
							</div>
							<div
								class="flex flex-wrap items-baseline justify-between gap-4 border border-dashed border-copper/50 px-4.5 py-3"
							>
								<span class="font-display text-[15px] font-semibold tracking-[-0.01em] text-ink">
									Hazard log — a living artefact, not an end-of-project document
								</span>
								<span class="text-xs tracking-[0.1em] text-copper uppercase">DCB0129</span>
							</div>
						</div>
					</div>
				</div>
			</div>

			<div class:list={["flex flex-wrap gap-7 pt-5 text-[12.5px] text-ink-mute", pagePad]}>
				<span class="flex items-center gap-2">
					<span class="h-3 w-3 flex-none border border-ink/25 bg-[#202020]"></span>Agent
				</span>
				<span class="flex items-center gap-2">
					<span class="h-3 w-3 flex-none border border-copper/70 bg-[#1F1B17]"></span>Human decision point
				</span>
				<span class="flex items-center gap-2">
					<span class="h-3 w-3 flex-none border border-dashed border-copper/60"></span>Safety artefact
				</span>
			</div>
		</div>
	</section>

	<!-- Article body: sticky contents rail + prose -->
	<div class="mx-auto flex max-w-[952px] items-start gap-16 px-5 pt-[clamp(40px,6vw,72px)]">
		<nav id="toc" class="sticky top-16 hidden w-[210px] flex-none pt-2 lg:block" aria-label="Contents">
			<p class="mb-4.5 text-[11px] tracking-[0.16em] text-ink-mute uppercase">Contents</p>
			<div class="relative pl-4.5">
				<div class="absolute top-0 bottom-0 left-0 w-px bg-ink/10" aria-hidden="true"></div>
				<div
					id="toc-bar"
					class="absolute top-0 left-0 h-9 w-px bg-copper transition-transform duration-300 ease-out"
					aria-hidden="true"
				>
				</div>
				{
					toc.map((item, i) => (
						<a
							href={`#${item.id}`}
							data-toc-link
							class:list={[
								"flex h-9 items-center text-[13.5px] transition-colors duration-300",
								i === 0 ? "text-ink" : "text-ink-mute",
							]}
						>
							{item.label}
						</a>
					))
				}
			</div>
		</nav>

		<article class="max-w-[660px] min-w-0 flex-1">
			<section id="why-healthcare-is-different" class="scroll-mt-18 pt-2">
				<h2 class={heading}>Why healthcare is different</h2>
				<p class={prose}>
					In most software, a bug is an inconvenience. In clinical software, a bug is a hazard — something that could
					contribute to patient harm — and the law treats it that way. Under DCB0129 every hazard has to be identified,
					scored for severity and likelihood, mitigated, and signed off by a Clinical Safety Officer before the software
					goes anywhere near a patient pathway.
				</p>
				<p class={prose}>
					The conventional response is to slow down: fewer releases, bigger review ceremonies, a hazard log updated in a
					painful batch just before each one. The premise of this project was the opposite — that the safety regime is
					mostly a <span class="text-ink">traceability problem</span>, and traceability is exactly the kind of diligent,
					unglamorous work agents are good at.
				</p>
			</section>

			<section id="the-agent-team" class="scroll-mt-18 pt-9">
				<h2 class={heading}>The agent team</h2>
				<p class={prose}>
					The lifecycle above is the whole system. Work enters as clinical intent from me, and a spec-writer agent turns
					it into requirements with explicit acceptance criteria. Crucially, a clinical-risk agent reads the same
					requirements and drafts hazard candidates <span class="text-ink">before any code exists</span> — safety
					analysis moves to the front of the process instead of trailing it.
				</p>
				<p class={prose}>
					Implementation runs in parallel, one agent per requirement, constrained to small diffs. A test-writer agent
					works from the spec rather than the code, so tests encode intent instead of ratifying whatever got built. Then
					everything funnels through an adversarial reviewer whose job is to argue against the change — because
					rejection by an agent costs minutes, we could afford a reviewer that is genuinely hard to please.
				</p>
			</section>

			<section id="the-living-hazard-log" class="scroll-mt-18 pt-9">
				<h2 class={heading}>The hazard log as a living artefact</h2>
				<p class={prose}>
					The dashed lane in the diagram is the part I'm proudest of. The hazard log isn't a spreadsheet someone dreads
					opening — it's a structured artefact in the repository, updated by the safety-case agent on every change that
					touches a hazard's mitigations. Each entry carries its lineage: the requirement that raised it, the code that
					mitigates it, the tests that prove the mitigation, and the review that accepted it.
				</p>
				<p class={prose}>
					This changes what the human gate feels like. The Clinical Safety Officer never faces a six-month backlog of
					undocumented change; they review a <span class="copper-mark">small, fully-traced delta</span> — this hazard,
					this mitigation, this evidence. Sign-off went from the slowest step in the process to one of the fastest,
					without diluting it, because the agents did the assembly and the human did the judging.
				</p>
			</section>

			<section id="quality-without-slowing" class="scroll-mt-18 pt-9 pb-[clamp(48px,7vw,80px)]">
				<h2 class={heading}>Quality without slowing down</h2>
				<p class={prose}>
					The result was the thing regulated environments are told they can't have: throughput. Lots of functionality
					shipped, in small releases, each one carrying its safety case with it. The regime didn't get thinner — it got
					denser, because keeping the paperwork true on every change is exactly the work humans skimp on and agents
					don't.
				</p>
				<p class="text-[17px] leading-[1.75] text-pretty text-ink-soft">
					The lesson I keep returning to: agents didn't replace the safety process, and they didn't replace the humans
					in it. They made the process cheap enough to run continuously — and a safety process you run continuously is a
					better safety process.
				</p>
			</section>
		</article>
	</div>

	<!-- Engineering journal -->
	<section>
		<div class:list={["flex items-baseline gap-4 pt-2 pb-1.5", pagePad]}>
			<SectionLabel>Engineering journal</SectionLabel>
			<span class="text-[13px] text-ink-mute opacity-70">In the order they happened</span>
		</div>
		<div class:list={["flex flex-col gap-2 pt-3 pb-2", bleed]}>
			{
				journal.map((entry) => (
					<a href="#" class="tile flex flex-wrap items-baseline gap-x-7 gap-y-2 px-[clamp(20px,3vw,40px)] py-6.5">
						<span class="w-[84px] flex-none text-[13px] text-copper tabular-nums">{entry.date}</span>
						<span class="min-w-[220px] flex-1">
							<span class="block font-display text-[21px] font-semibold tracking-[-0.02em] text-ink">
								{entry.title}
							</span>
							<span class="mt-1 block text-[14.5px] text-ink-mute">{entry.blurb}</span>
						</span>
						<span class="text-lg text-ink-soft" aria-hidden="true">
							→
						</span>
					</a>
				))
			}
		</div>
	</section>

	<!-- Lessons learned -->
	<section>
		<SectionLabel class:list={["pt-8 pb-1.5", pagePad]}>Lessons learned</SectionLabel>
		<div class:list={["pt-3", bleed]}>
			<div class="grid grid-cols-[repeat(auto-fit,minmax(260px,1fr))] gap-2">
				{
					lessons.map((lesson, i) => (
						<div class:list={["bg-card", cardPad]}>
							<p class="mb-3.5 text-[13px] text-copper tabular-nums">{String(i + 1).padStart(2, "0")}</p>
							<p class="font-display text-[19px] leading-[1.45] font-medium tracking-[-0.01em] text-pretty text-ink">
								{lesson}
							</p>
						</div>
					))
				}
			</div>
		</div>
	</section>
</Layout>

<style is:global>
	html {
		scroll-behavior: smooth;
	}
</style>

<script>
	// Reading aids ported from the design component: a copper progress bar
	// across the top, and a scroll-spy for the contents rail (the copper tick
	// slides to the active section; 36px per row matches the h-9 links).
	const progressBar = document.getElementById("reading-progress");
	const tocBar = document.getElementById("toc-bar");
	const links = [...document.querySelectorAll<HTMLAnchorElement>("[data-toc-link]")];
	const sections = links.map((link) => document.querySelector(link.getAttribute("href") ?? ""));

	function update() {
		const doc = document.documentElement;
		const max = doc.scrollHeight - window.innerHeight;
		if (progressBar) progressBar.style.width = `${(max > 0 ? Math.min(1, window.scrollY / max) : 0) * 100}%`;

		let active = 0;
		sections.forEach((section, i) => {
			if (section && section.getBoundingClientRect().top < 180) active = i;
		});
		if (tocBar) tocBar.style.transform = `translateY(${active * 36}px)`;
		for (const [i, link] of links.entries()) {
			link.classList.toggle("text-ink", i === active);
			link.classList.toggle("text-ink-mute", i !== active);
		}
	}

	update();
	window.addEventListener("scroll", update, { passive: true });
	window.addEventListener("resize", update);
</script>
