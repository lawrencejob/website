---
import Layout from "../layouts/Layout.astro";
import Card from "../components/Card.astro";
import SectionLabel from "../components/SectionLabel.astro";
import ScrollRow from "../components/ScrollRow.astro";

const labelPad = "px-5 pb-1.5 md:px-14 md:pb-2";
const scrollCard = "flex-none snap-start md:w-auto";
---

<Layout title="Lawrence Job">
	<!-- Hero -->
	<section class="px-5 pt-14 pb-11 md:max-w-[900px] md:px-14 md:pt-29 md:pb-23">
		<p
			class="text-base leading-[1.6] text-pretty text-ink-soft md:max-w-[580px] md:text-[19px] md:leading-[1.7]"
		>
			I’m Lawrence. I’m a <span class="text-ink">systems engineer</span> at heart, and I apply that mindset to <span
				class="copper-mark">software</span
			>, <span class="copper-mark">teams</span> and <span class="copper-mark">products</span>.<span
				class="hidden md:inline">{" Here’s what I build, write and think about."}</span
			>
		</p>
		<div class="mt-6.5 flex gap-6 text-xs tracking-[0.08em] uppercase md:mt-10 md:gap-8 md:text-[13px]">
			<a href="/lawrence-job-cv.pdf" download target="_blank" rel="noopener" class="border-b border-copper pb-[3px] text-ink">CV ↓</a>
			<a href="https://linkedin.com/lawrencejob" class="pb-[3px] text-ink-mute transition-colors duration-200 hover:text-ink">LinkedIn ↗</a>
		</div>
	</section>

	<!-- Work -->
	<section>
		<SectionLabel class={labelPad}>Work</SectionLabel>
		<ScrollRow class="md:grid-cols-[2fr_1fr]">
			<Card
				href="/work/departures"
				eyebrow="Flagship · Native iOS"
				title="Departures"
				class:list={[scrollCard, "min-h-[300px] w-[290px] px-5 py-7 md:px-10 md:py-9"]}
				titleClass="text-[30px] md:text-[38px]"
			>
				A real-time app for the UK railway. The product thinking, the graph architecture, and a journal of the
				genuinely hard bits.
			</Card>
			<Card
				href="/work/agentic-pipeline"
				eyebrow="Case study"
				title="Agentic Pipeline in Healthcare"
				class:list={[scrollCard, "min-h-[300px] w-[290px] px-5 py-7 md:px-10 md:py-9"]}
				titleClass="text-[26px] leading-[1.12] md:text-[30px] md:leading-[1.1]"
			>
				How I shipped a real product change with agents doing the typing — and me owning everything else.
			</Card>
		</ScrollRow>
	</section>

	<!-- Thoughts -->
	<section class="pt-6 md:pt-8">
		<SectionLabel class={labelPad}>Thoughts</SectionLabel>
		<ScrollRow class="md:grid-cols-3">
			<Card
				href="/thoughts/2026-05-concordance"
				title="Concordance"
				class:list={[scrollCard, "min-h-[230px] w-[200px] px-5 py-6 md:px-10 md:py-8"]}
				titleClass="text-[22px] md:text-[28px]"
			>
				Essays on ideas that look like they conflict, but don’t.<span class="hidden md:inline"
					>{" Speed and quality. Product and engineering. AI and craft."}</span
				>
			</Card>
			<Card
				href="/thoughts/observations"
				title="Observations"
				class:list={[scrollCard, "min-h-[230px] w-[200px] px-5 py-6 md:px-10 md:py-8"]}
				titleClass="text-[22px] md:text-[28px]"
			>
				<span class="md:hidden">Systems in everyday life — cities, transport, koi ponds.</span>
				<span class="hidden md:inline"
					>Shorter notes on systems in everyday life — cities, public transport, koi ponds.</span
				>
			</Card>
			<Card
				href="/thoughts/2026-06-koi-pond"
				title="Latest essay"
				class:list={[scrollCard, "min-h-[230px] w-[200px] px-5 py-6 md:px-10 md:py-8"]}
				titleClass="text-[22px] md:text-[28px]"
			>
				Koi ponds and cities.
			</Card>
		</ScrollRow>
	</section>

	<!-- Mentoring -->
	<section class="pt-6 md:pt-8">
		<SectionLabel class={labelPad}>Mentoring</SectionLabel>
		<div class="pt-2 md:px-14 md:pt-3">
			<a
				href="/mentoring"
				class="tile flex items-center justify-between gap-4 px-5 py-6 md:gap-6 md:px-10 md:py-7"
			>
				<div class="md:flex md:flex-wrap md:items-baseline md:gap-5">
					<p class="font-display text-lg leading-[1.3] font-semibold tracking-[-0.02em] text-ink md:text-[22px]">
						<span class="md:hidden">Working towards staff engineering?</span>
						<span class="hidden md:inline">Working towards staff engineering or technical leadership?</span>
					</p>
					<p class="mt-1.5 text-sm text-ink-mute md:mt-0 md:text-[15px]">I mentor engineers — happy to talk.</p>
				</div>
				<span class="text-lg text-ink-soft md:text-xl" aria-hidden="true">→</span>
			</a>
		</div>
	</section>
</Layout>
