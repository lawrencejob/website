---
export interface Crumb {
	label: string;
	href?: string;
}

interface Props {
	crumbs?: Crumb[];
}

const { crumbs } = Astro.props;

// On top-level pages the trail is a single crumb, which just repeats the page
// title. Prepend a linked "Home" so the breadcrumb reads as a location.
const trail = crumbs && crumbs.length === 1 ? [{ label: "Home", href: "/" }, ...crumbs] : crumbs;

const nav = [
	{ label: "About", href: "/about" },
	{ label: "Work", href: "/work" },
	{ label: "Thoughts", href: "/thoughts" },
	{ label: "Mentoring", href: "/mentoring" },
];
---

<header>
	<!-- Mobile: no hamburger — the whole bar is Home -->
	<a
		href="/"
		class="flex items-center justify-between border-b border-hairline px-5 py-4.5 transition-colors duration-300 hover:bg-card-hover active:bg-card-active md:hidden"
	>
		<span class="font-display text-sm font-semibold tracking-[-0.01em] text-ink">Lawrence Job</span>
		<span class="text-[17px] leading-none text-ink-mute" aria-hidden="true">⌂</span>
	</a>

	<!-- Desktop: name + full nav -->
	<div class="hidden border-b border-hairline md:block">
		<div class="mx-auto flex max-w-[1440px] items-center justify-between px-14 py-6.5">
			<a href="/" class="font-display text-[15px] font-semibold tracking-[-0.01em] text-ink">Lawrence Job</a>
			<nav class="flex gap-9 text-[13px]">
				{
					nav.map((item) => (
						<a href={item.href} class="text-ink-mute transition-colors duration-200 hover:text-ink">
							{item.label}
						</a>
					))
				}
			</nav>
		</div>
	</div>

	{
		trail && trail.length > 0 && (
			<div class="border-b border-hairline">
				<nav
					aria-label="Breadcrumb"
					class="mx-auto flex max-w-[1440px] items-baseline gap-2.5 px-5 py-3.5 text-[13px] md:px-14"
				>
					{trail.map((crumb, i) => (
						<Fragment>
							{i > 0 && (
								<span class="text-copper" aria-hidden="true">
									/
								</span>
							)}
							{crumb.href ? (
								<a href={crumb.href} class="text-ink-mute transition-colors duration-200 hover:text-ink">
									{crumb.label}
								</a>
							) : (
								<span class="text-ink">{crumb.label}</span>
							)}
						</Fragment>
					))}
				</nav>
			</div>
		)
	}
</header>
