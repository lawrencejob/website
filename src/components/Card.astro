---
// Linked card: optional eyebrow, display title, body (default slot), arrow.
import Eyebrow from "./Eyebrow.astro";

interface Props {
	href: string;
	title: string;
	eyebrow?: string;
	class?: string;
	titleClass?: string;
}

const { href, title, eyebrow, class: className, titleClass } = Astro.props;
---

<a href={href} class:list={["tile flex flex-col justify-between gap-5", className]}>
	<div>
		{eyebrow && <Eyebrow class="mb-3 md:mb-4">{eyebrow}</Eyebrow>}
		<h3 class:list={["font-display font-semibold tracking-[-0.02em] text-ink", titleClass]}>{title}</h3>
	</div>
	<div class="flex items-end justify-between gap-4 md:gap-6">
		<p class="text-sm leading-[1.55] text-ink-mute md:max-w-[460px] md:text-[15px]"><slot /></p>
		<span class="text-lg text-ink-soft md:text-xl" aria-hidden="true">→</span>
	</div>
</a>
